<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:aimn="https://aitmation.com/schema/aimn/1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_document-review" targetNamespace="https://aitmation.com/solutions">
  <bpmn:process id="document-review" name="Dokument prüfen" isExecutable="true" aimn:version="1">
    <bpmn:extensionElements>
      <aimn:meta>
        <aimn:title lang="de">Dokument prüfen</aimn:title>
        <aimn:title lang="fr">Vérifier le document</aimn:title>
        <aimn:title lang="it">Verificare il documento</aimn:title>
        <aimn:title lang="en">Review document</aimn:title>
        <aimn:description lang="de">Menschliche Prüfung des aufbereiteten Dokuments.</aimn:description>
        <aimn:description lang="fr">Vérification humaine du document préparé.</aimn:description>
        <aimn:description lang="it">Verifica umana del documento preparato.</aimn:description>
        <aimn:description lang="en">Human review of the prepared document.</aimn:description>
      </aimn:meta>
      <aimn:contract>
        <aimn:input name="summary">Zusammenfassung aus document-read</aimn:input>
      </aimn:contract>
      <aimn:policy name="sla">
        <aimn:property name="remind_after_hours" value="24" />
        <aimn:property name="escalate_after_hours" value="48" />
      </aimn:policy>
    </bpmn:extensionElements>
    <bpmn:startEvent id="intake" name="intake">
      <bpmn:extensionElements>
        <aimn:trigger source="chain" />
      </bpmn:extensionElements>
      <bpmn:documentation>intake</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:userTask id="review" name="review">
      <bpmn:extensionElements>
        <aimn:gate />
      </bpmn:extensionElements>
      <bpmn:documentation>review</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="review_deadline" attachedToRef="review" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_intake_fired" name="fired" sourceRef="intake" targetRef="review" />
    <bpmn:endEvent id="to_document_archive">
      <bpmn:extensionElements>
        <aimn:chainTo process="document-archive" />
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_review_approved" name="approved" sourceRef="review" targetRef="to_document_archive" />
    <bpmn:endEvent id="finished" />
    <bpmn:sequenceFlow id="flow_review_rejected" name="rejected" sourceRef="review" targetRef="finished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_document-review">
    <bpmndi:BPMNPlane id="plane_document-review" bpmnElement="document-review">
      <bpmndi:BPMNShape id="shape_intake" bpmnElement="intake">
        <dc:Bounds x="160" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_review" bpmnElement="review">
        <dc:Bounds x="360" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_to_document_archive" bpmnElement="to_document_archive">
        <dc:Bounds x="560" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_finished" bpmnElement="finished">
        <dc:Bounds x="560" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_review_deadline" bpmnElement="review_deadline">
        <dc:Bounds x="442" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_intake_fired" bpmnElement="flow_intake_fired">
        <di:waypoint x="196" y="160" />
        <di:waypoint x="360" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_review_approved" bpmnElement="flow_review_approved">
        <di:waypoint x="460" y="160" />
        <di:waypoint x="560" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_review_rejected" bpmnElement="flow_review_rejected">
        <di:waypoint x="460" y="160" />
        <di:waypoint x="560" y="290" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
